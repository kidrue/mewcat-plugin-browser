{
    "name": "mewcat-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.20.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "postinstall": "pnpm build:packages && pnpm --filter @mewcat/extension exec wxt prepare",
        "build:packages": "pnpm -r --filter \"./packages/**\" build",
        "dev:extension": "pnpm build:packages && pnpm -r --parallel --filter \"@mewcat/extension...\" dev",
        "dev:service": "pnpm build:packages && pnpm -r --parallel --filter \"@mewcat/service...\" dev",
        "build:extension": "pnpm --filter \"@mewcat/extension...\" -r build",
        "build:service": "pnpm --filter \"@mewcat/service...\" -r build",
        "build": "pnpm -r build",
        "build:verify": "node scripts/verify-builds.mjs",
        "test:workspace": "node --test tests/workspace.test.mjs tests/workspace-env.test.mjs tests/workflow-routing.test.mjs",
        "check": "pnpm test:workspace && pnpm build:packages && pnpm -r --filter \"@mewcat/*\" check",
        "format": "prettier --write \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"packages/**/*.{ts,json}\" \"apps/service/**/*.{ts,json}\" && pnpm --filter @mewcat/extension format",
        "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"packages/**/*.{ts,json}\" \"apps/service/**/*.{ts,json}\" && pnpm --filter @mewcat/extension format:check"
    },
    "devDependencies": {
        "prettier": "3.5.3",
        "@ianvs/prettier-plugin-sort-imports": "4.5.0",
        "yaml": "2.8.1"
    }
}
