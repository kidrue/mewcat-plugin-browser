{
    "name": "mewcat-plugin-browser",
    "displayName": "mewCat",
    "private": true,
    "type": "module",
    "version": "0.0.1",
    "packageManager": "pnpm@10.20.0",
    "scripts": {
        "predev": "node scripts/check-legacy-output.cjs",
        "dev": "wxt",
        "prebuild": "node scripts/check-legacy-output.cjs",
        "build": "node scripts/build-with-timing.cjs",
        "package": "node scripts/package-with-date.cjs",
        "package:dev": "node scripts/package-dev.cjs",
        "crx": "node scripts/build-crx.cjs",
        "obfuscate": "node scripts/obfuscate.cjs",
        "postinstall": "wxt prepare",
        "lint": "eslint --config ./eslint.config.mjs src/",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc --noEmit --watch",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
        "format:check": "prettier --debug-check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
        "format:diff": "prettier -w \"src/translation/DOMTraverser.ts\"",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:hotlink-rules && pnpm spell && pnpm test:google && pnpm test:selection && pnpm test:image",
        "check:all": "pnpm typecheck && pnpm lint && pnpm format:check",
        "spell": "cspell \"**/*.{ts,tsx,js,scss,css,jsx,md}\"",
        "knip": "knip",
        "commit": "git cz",
        "clean": "rimraf \"**/{node_modules,build,dist,.{cache,log},log,.plasmo,.wxt,.output}\" pnpm-lock.yaml",
        "zip:prod": " pnpm clean:prod:zip && pnpm package",
        "clean:prod:zip": "rimraf .output/chrome-mv3-prod*.zip",
        "test:rpc": "npx tsx ./test/test-rpc.ts",
        "test:rpc:web": "node ./test/test-server.mjs",
        "test:401": "npx tsx ./test/test-401-interceptor.ts",
        "test:google": "npx tsx ./test/test-google-translate.ts",
        "test:selection": "npx tsx ./test/test-selection-translate.ts && npx tsx ./test/test-selection-translate-hook.tsx",
        "test:image": "vitest run --config test/vitest.image-translation.config.ts test/background-image-translation.test.ts test/image-translation-contracts.test.ts test/image-translation-content.test.tsx test/image-translation-controller.test.ts test/image-translation-overlay.test.ts test/image-translation-preprocess-cache.test.ts test/image-translation-providers.test.ts test/image-translation-service.test.ts test/image-settings-ui.test.tsx test/vision-models.test.ts",
        "sync:hotlink-rules": "node scripts/sync-hotlink-sites-from-immersive.cjs",
        "check:hotlink-rules": "node scripts/sync-hotlink-sites-from-immersive.cjs --check"
    },
    "dependencies": {
        "@connectrpc/connect": "2.1.0",
        "@connectrpc/connect-web": "2.1.0",
        "@connectrpc/protoc-gen-connect-es": "1.7.0",
        "@floating-ui/core": "1.7.3",
        "@floating-ui/react": "0.27.16",
        "@mozilla/readability": "^0.6.0",
        "@webext-core/messaging": "4.0.0",
        "@xsai/generate-object": "0.4.4",
        "@xsai/generate-text": "0.4.4",
        "@xsai/model": "0.4.4",
        "axios": "1.11.0",
        "date-fns": "4.1.0",
        "franc": "6.2.0",
        "jotai": "2.13.1",
        "nanoid": "4.0.2",
        "ramda": "0.31.3",
        "react": "18.3.0",
        "react-dom": "18.3.0",
        "react-use": "17.4.0",
        "styled-components": "6.1.8",
        "use-immer": "0.11.0",
        "zod": "4.0.15"
    },
    "devDependencies": {
        "@bufbuild/buf": "^1.57.2",
        "@bufbuild/connect-web": "0.13.0",
        "@bufbuild/protobuf": "2.9.0",
        "@bufbuild/protoc-gen-es": "2.9.0",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/modifiers": "9.0.0",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@eslint/js": "9.24.0",
        "@ianvs/prettier-plugin-sort-imports": "4.5.0",
        "@types/chrome": "0.0.263",
        "@types/jsdom": "21.1.7",
        "@types/node": "20",
        "@types/ramda": "0.27.0",
        "@types/react": "18.3.0",
        "@types/react-dom": "18.3.0",
        "@types/styled-components": "5.1.34",
        "@typescript-eslint/eslint-plugin": "8.30.1",
        "@typescript-eslint/parser": "8.30.1",
        "@wxt-dev/auto-icons": "1.1.2",
        "@wxt-dev/module-react": "1.2.2",
        "chalk": "4.1.2",
        "crx": "5.0.1",
        "cspell": "6.0.0",
        "esbuild": "0.28.0",
        "eslint": "9.24.0",
        "eslint-config-prettier": "10.1.2",
        "eslint-plugin-prettier": "5.2.6",
        "eslint-plugin-react-hooks": "5.2.0",
        "fs-extra": "11.1.0",
        "git-cz": "4.9.0",
        "glob": "11.0.0",
        "husky": "8.0.2",
        "javascript-obfuscator": "4.1.0",
        "jsdom": "26.1.0",
        "knip": "1.1.0",
        "prettier": "3.5.3",
        "react-error-boundary": "4.0.12",
        "rimraf": "3.0.2",
        "typescript": "5.8.3",
        "typescript-eslint": "8.30.1",
        "vite": "8.2.1",
        "vitest": "^4.1.10",
        "wxt": "0.21.4",
        "zx": "8.8.0"
    },
    "config": {
        "commitizen": {
            "path": "git-cz"
        }
    }
}
